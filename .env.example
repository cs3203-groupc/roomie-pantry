# Gemini API Key (for AI Recipe Generator & Kitchen Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Persistence Configuration:
# - Set DATABASE_TYPE to 'sqlite' (default zero-config local storage) or 'firebase' (Google Cloud Firestore)
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/pantry.sqlite

# Firebase Configuration (Optional - for cloud persistence with Firebase Firestore)
# To use Firebase:
# 1. Set DATABASE_TYPE=firebase
# 2. Provide your Firebase Project ID and Service Account:
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Or provide the credentials directly as a JSON string:
# FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id": "...", "private_key": "...", "client_email": "..."}'
